{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": false,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "plugins": [{"name": "next"}],
        "baseUrl": ".",
        "paths": {"@/*": ["./*"]}
    },
    "include": [
        "next-env.d.ts",
        "app/**/*.ts",
        "app/**/*.tsx",
        "components/**/*.tsx",
        "data/**/*.ts",
        "features/**/*.ts",
        "features/**/*.tsx",
        "lib/**/*.ts",
        "tests/**/*.ts",
        "store/**/*.ts",
        "types/**/*.ts",
        "tailwind.config.ts",
        "vitest.config.ts",
        "vitest.setup.ts",
        "playwright.config.ts",
        ".next/types/**/*.ts"
    ],
    "exclude": ["node_modules", "docs", "out"]
}
